# LOGOS Cognition Service — environment variables
# Copy to .env and fill in values.

# Server port (default 8787)
PORT=8787

# LLM provider: deepseek | openai | stub (stub = deterministic fake, no API calls)
LLM_PROVIDER=stub

# DeepSeek API key (required when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Data directory for JSON file store (default ./data)
DATA_DIR=./data
