{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clickclack",
  "account_id": "fbfc23520c471e4dba1834827a980a14",
  "main": "infra/cloudflare/worker.ts",
  "compatibility_date": "2026-05-17",
  "workers_dev": false,
  "routes": [
    { "pattern": "app.catabolicsolutions.com", "custom_domain": true }
  ],
  "vars": {
    "CLICKCLACK_PUBLIC_URL": "https://app.catabolicsolutions.com",
    "CLICKCLACK_UPSTREAM_URL": "http://137.184.144.196.nip.io:8090",
    "CLICKCLACK_CONTAINER_NAME": "prod-20260722-embed-fit",
    "CLICKCLACK_GITHUB_MODERATOR_ORG": "openclaw",
    "CLICKCLACK_UPLOADS": "r2://clickclack-uploads/prod",
    "CLICKCLACK_R2_ACCOUNT_ID": "fbfc23520c471e4dba1834827a980a14"
  },
  "secrets": {
    "required": [
      "CLICKCLACK_DB",
      "CLICKCLACK_GITHUB_CLIENT_ID",
      "CLICKCLACK_GITHUB_CLIENT_SECRET",
      "CLICKCLACK_R2_ACCESS_KEY_ID",
      "CLICKCLACK_R2_SECRET_ACCESS_KEY"
    ]
  },
  "containers": [
    {
      "class_name": "ClickClackContainer",
      "image": "./Dockerfile.cloudflare",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 2,
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLICKCLACK_CONTAINER",
        "class_name": "ClickClackContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ClickClackContainer"
      ]
    }
  ]
}
