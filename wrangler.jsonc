{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clickclack",
  "account_id": "91b59577e757131d68d55a471fe32aca",
  "main": "infra/cloudflare/worker.ts",
  "compatibility_date": "2026-05-17",
  "workers_dev": false,
  "build": {
    "command": "bash -euo pipefail -c 'export CLICKCLACK_BUILD_FLAVOR=cloudflare; source scripts/docker-build-metadata.sh; install -d -m 0700 .pnpm-store; printf \"CLICKCLACK_VERSION=%s\\nCLICKCLACK_COMMIT=%s\\nCLICKCLACK_BUILD_DATE=%s\\n\" \"$CLICKCLACK_VERSION\" \"$CLICKCLACK_COMMIT\" \"$CLICKCLACK_BUILD_DATE\" >.pnpm-store/clickclack-cloudflare-build.env; chmod 0600 .pnpm-store/clickclack-cloudflare-build.env'"
  },
  "routes": [
    { "pattern": "clickclack.chat", "custom_domain": true },
    { "pattern": "www.clickclack.chat", "custom_domain": true },
    { "pattern": "app.clickclack.chat", "custom_domain": true }
  ],
  "vars": {
    "CLICKCLACK_PUBLIC_URL": "https://app.clickclack.chat",
    "CLICKCLACK_CONTAINER_NAME": "prod-20260705-open-org",
    "CLICKCLACK_GITHUB_MODERATOR_ORG": "openclaw",
    "CLICKCLACK_UPLOADS": "r2://clickclack-uploads/prod",
    "CLICKCLACK_R2_ACCOUNT_ID": "91b59577e757131d68d55a471fe32aca"
  },
  "secrets": {
    "required": [
      "CLICKCLACK_DB",
      "CLICKCLACK_GITHUB_CLIENT_ID",
      "CLICKCLACK_GITHUB_CLIENT_SECRET",
      "CLICKCLACK_R2_ACCESS_KEY_ID",
      "CLICKCLACK_R2_SECRET_ACCESS_KEY"
    ]
  },
  "containers": [
    {
      "class_name": "ClickClackContainer",
      "image": "./Dockerfile.cloudflare",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 2,
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLICKCLACK_CONTAINER",
        "class_name": "ClickClackContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ClickClackContainer"
      ]
    }
  ]
}
